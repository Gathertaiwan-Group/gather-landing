# ── Supabase (Gather 專案: ref xdyldehjoobvdgddcalh) ──
# 專案啟用後，於 Supabase Dashboard → Project Settings → API 取得 anon / service_role key
NEXT_PUBLIC_SUPABASE_URL=https://xdyldehjoobvdgddcalh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅 server 端使用，請勿加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend 新諮詢通知（聯絡表單／AI 客服抓到聯絡時寄 Email 給老闆）──
# 寄件網域需在 Resend 驗證；RESEND_FROM 例：給樂數位 <noreply@gathertaiwan.com>
RESEND_API_KEY=
RESEND_FROM=
CONTACT_NOTIFY_TO=

# ── 報價單自動跟進 cron（Vercel Cron 每日；CRON_SECRET 必填，否則 cron 一律 401）──
CRON_SECRET=
QUOTE_FOLLOWUP_DAYS=3

# ── 部落格寫入 API（hermes agent 用）──
# 強隨機字串；agent 以 Authorization: Bearer <此值> 呼叫 /api/blog
BLOG_API_TOKEN=
NEXT_PUBLIC_SITE_URL=https://gathertaiwan.com

# 部落格自動配圖（Pexels）
PEXELS_API_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# 官網 AI 展示（Gemini）
GEMINI_API_KEY=

# ── 後台 (Admin Dashboard) — /admin ──
# 老闆登入後台的密碼（建議強隨機字串）
ADMIN_PASSWORD=
# 簽發後台 session cookie 的 HMAC 密鑰（長隨機、勿外流；於 Vercel 更改後需重新部署才生效）
ADMIN_SESSION_SECRET=
